# Neon (`neon env pull` las llena): DATABASE_URL es la URL con pooler (la usa la app) y
# DATABASE_URL_UNPOOLED la directa (la usa Prisma CLI para migraciones).
# Para usar el Postgres local de docker-compose.yml, pon la misma URL en ambas.
DATABASE_URL="postgresql://my_expenses:my_expenses@localhost:5433/my_expenses"
DATABASE_URL_UNPOOLED="postgresql://my_expenses:my_expenses@localhost:5433/my_expenses"

# Login con Google (Better Auth). Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Credenciales del cliente OAuth de Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Único correo de Google que puede entrar
ALLOWED_EMAIL=""
