generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  expense
  income
}

/// Las categorías por defecto se insertan en la migración `custom_categories` con ids legibles ("groceries", "salary"…).
model Category {
  id           String          @id @default(uuid())
  type         TransactionType
  name         String
  /// Clave de `CATEGORY_ICONS` en src/lib/category-styles.ts.
  icon         String
  /// Clave de `CATEGORY_PALETTES` en src/lib/category-styles.ts.
  palette      String
  /// Orden en la cuadrícula de "Nuevo movimiento".
  position     Int
  /// Una categoría con movimientos no se borra: se archiva para conservar el historial.
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  transactions Transaction[]

  @@index([type, position])
  @@map("categories")
}

model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  type       TransactionType
  /// Siempre positivo; el signo lo da `type`.
  amount     Decimal         @db.Decimal(12, 2)
  categoryId String          @map("category_id")
  category   Category        @relation(fields: [categoryId], references: [id])
  concept    String?
  note       String?
  date       DateTime        @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Gasto generado por un monto prestado que cuenta en los totales. Se edita desde el préstamo y se borra con el monto.
  loanItemId    String?      @unique @map("loan_item_id") @db.Uuid
  loanItem      LoanItem?    @relation(fields: [loanItemId], references: [id], onDelete: Cascade)
  /// Ingreso generado por un abono de un préstamo que cuenta en los totales. Se borra con el abono.
  loanPaymentId String?      @unique @map("loan_payment_id") @db.Uuid
  loanPayment   LoanPayment? @relation(fields: [loanPaymentId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@map("transactions")
}

/// Dinero que presté a alguien, en uno o varios montos, y me van abonando. El total y el saldo pendiente
/// se calculan con los montos y los abonos, no se almacenan.
model Loan {
  id            String        @id @default(uuid()) @db.Uuid
  /// A quién se le prestó.
  borrower      String
  /// Si es true, cada monto tiene un movimiento de gasto y cada abono uno de ingreso, con las categorías
  /// de sistema "Préstamos" (`loans` y `loan-repayments`).
  countInTotals Boolean       @default(true) @map("count_in_totals")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  items         LoanItem[]
  payments      LoanPayment[]

  @@map("loans")
}

/// Cada cosa que se prestó dentro de un préstamo ("Moto", "Préstamo de dinero").
model LoanItem {
  id          String       @id @default(uuid()) @db.Uuid
  loanId      String       @map("loan_id") @db.Uuid
  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  concept     String
  amount      Decimal      @db.Decimal(12, 2)
  date        DateTime     @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction Transaction?

  @@index([loanId, date])
  @@map("loan_items")
}

model LoanPayment {
  id          String       @id @default(uuid()) @db.Uuid
  loanId      String       @map("loan_id") @db.Uuid
  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(12, 2)
  date        DateTime     @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction Transaction?

  @@index([loanId, date])
  @@map("loan_payments")
}
